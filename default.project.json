        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "ShadowMap",
        "ClockTime": 0,
        "Brightness": 2,
        "Ambient": [0.28, 0.28, 0.38],
        "OutdoorAmbient": [0.32, 0.3, 0.42],
        "FogColor": [0.09, 0.07, 0.16],
        "FogEnd": 1200,
        "GlobalShadows": true
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [512, 20, 512],
          "Position": [0, -10, 0],
          "Material": "Slate",
          "Color": [0.08, 0.08, 0.12],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "Position": [0, 1.4, 10],
          "Material": "Neon",
          "Color": [0.9, 0.3, 1.0],
          "Duration": 0,
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "DuelPad": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [10, 1, 10],
          "Position": [0, 1.4, -30],
          "Material": "Neon",
          "Color": [0.2, 1.0, 0.85],
