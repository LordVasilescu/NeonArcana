{
  "name": "NeonArcana",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "CastRequest": { "$className": "RemoteEvent" },
        "BattleState": { "$className": "RemoteEvent" },
        "BattleEnd": { "$className": "RemoteEvent" },
        "HUDUpdate": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" },
        "UnlockZone": { "$className": "RemoteEvent" },
        "SelectSchool": { "$className": "RemoteEvent" },
        "DeckUpdate": { "$className": "RemoteEvent" },
        "BuyPack": { "$className": "RemoteEvent" },
        "BuyMount": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
