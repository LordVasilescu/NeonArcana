{
  "editor.formatOnSave": true,
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "files.eol": "\n",
  "files.associations": {
    "*.luau": "luau",
    "*.project.json": "jsonc"
  },
  "luau-lsp.platform.type": "roblox",
  "luau-lsp.sourcemap.enabled": true,
  "luau-lsp.sourcemap.autogenerate": true,
  "luau-lsp.sourcemap.rojoProjectFile": "default.project.json",
  "luau-lsp.sourcemap.includeNonScripts": true,
  "luau-lsp.ignoreGlobs": ["**/_Index/**", "Packages/**"],
  "luau-lsp.require.mode": "relativeToFile",
  "luau-lsp.types.definitionFiles": ["globalTypes.d.luau"],
  "stylua.searchParentDirectories": true,
  "selene.run": "onType",
  "search.exclude": {
    "build/**": true,
    "assets/raw/**": true,
    "assets/export/**": true,
    "sourcemap.json": true
  }
}
